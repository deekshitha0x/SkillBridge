generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  role            String?        // "student", "recruiter", "institution"
  institutionId   String?
  aadhaarVerified Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  institution     Institution?   @relation(fields: [institutionId], references: [id])
  studentSkills   StudentSkill[]
  company         Company?
  submissions     Submission[]
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model Skill {
  id            String         @id @default(uuid())
  name          String         @unique
  studentSkills StudentSkill[]
}

model StudentSkill {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  status    String   @default("pending") // "verified", "claimed", "pending"
  level     Int      @default(0) // 0 to 5
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Assessment {
  id        String   @id @default(uuid())
  skillId   String   @unique
  questions Json     // List of MCQ objects [{ id, question, options, correctAnswerIndex }]
  passScore Int      @default(70)
  createdAt DateTime @default(now())
}

model Company {
  id          String   @id @default(uuid())
  name        String
  recruiterId String   @unique
  createdAt   DateTime @default(now())

  recruiter User  @relation(fields: [recruiterId], references: [id])
  jobs      Job[]
}

model Job {
  id             String      @id @default(uuid())
  companyId      String
  title          String
  description    String
  requiredSkills Json        // [{ skillId, skillName, minLevel }]
  createdAt      DateTime    @default(now())

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  challenges Challenge[]
}

model Challenge {
  id               String       @id @default(uuid())
  jobId            String
  title            String
  description      String
  requiredSkills   Json         // [{ skillId, skillName, minLevel }]
  difficultyLevel  Int          @default(1)
  timeLimitMinutes Int          @default(60)
  status           String       @default("open") // "open", "closed"
  createdAt        DateTime     @default(now())

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id                  String    @id @default(uuid())
  challengeId         String
  userId              String
  content             String
  status              String    @default("pending") // "pending", "reviewed"
  hiringStatus        String    @default("pending") // "pending", "shortlisted", "hired", "rejected"
  verifiedByRecruiter Boolean   @default(false)
  tabSwitches         Int       @default(0)
  createdAt           DateTime  @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

